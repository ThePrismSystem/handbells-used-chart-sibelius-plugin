{
  "name": "handbells-used-chart-sibelius",
  "version": "1.3.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Sibelius plugin that charts every handbell and handchime a piece uses",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "lint": "node tools/lint.mjs",
    "deploy": "node tools/build.mjs && node tools/deploy.mjs",
    "test": "node --test tools/__tests__/*.test.mjs",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=tools/*.mjs --test-coverage-lines=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tools/__tests__/*.test.mjs",
    "package": "node tools/build.mjs && node tools/package.mjs"
  }
}
